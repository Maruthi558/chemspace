# ==============================================================================
# CHEMSPACE CLIENT & BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Custom API Backend Endpoint (optional)
VITE_API_URL=

# Backend Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
SECRET_KEY=generate_a_secure_random_hex_key_here
CORS_ORIGINS=https://che445.com,https://chemistry-46c1c-4dac1.web.app,https://maruthii-5b928.firebaseapp.com,https://maruthii-5b928.web.app,http://localhost:5173,http://127.0.0.1:5173

# Optional Scientific Providers
AI_API_KEY=
IBM_RXN_API_KEY=

# Real Email Delivery Providers (Configure at least one for live inbox delivery)
# Option A: Resend API (Recommended: simple, high deliverability)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=ChemSpace Security <auth@yourdomain.com>

# Option B: Standard SMTP (Gmail, Outlook, Amazon SES, Brevo, custom mail server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=ChemSpace Security <your-email@gmail.com>
SMTP_SSL=false

# Option C: SendGrid API
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM=auth@yourdomain.com

# Optional Server-Side SMS Provider (Note: Firebase Phone Auth is the primary SMS gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

