# ==============================================================================
# CHEMNOVA SELF-HOSTED CHEMISTRY LLM CONFIGURATION (STEP 1)
# ==============================================================================

# Local Model & Tokenizer Paths (relative to chemistry_llm or absolute)
MODEL_PATH=models/base
TOKENIZER_PATH=models/base
DATA_PATH=data/processed
CHECKPOINT_PATH=models/checkpoints

# Hardware Execution Target: auto | cpu | cuda | mps
DEVICE=auto

# Inference & Sampling Parameters
MAX_CONTEXT_LENGTH=2048
TEMPERATURE=0.2
TOP_P=0.9

# Server Configuration
LLM_HOST=127.0.0.1
LLM_PORT=8001
